# Copie para functions/.dev.vars somente em ambiente local.
GITHUB_CLIENT_ID=coloque-o-client-id-aqui
GITHUB_CLIENT_SECRET=coloque-o-client-secret-aqui
PUBLIC_SITE_ORIGIN=http://127.0.0.1:8788
GITHUB_OAUTH_SCOPE=public_repo
GOOGLE_CLIENT_ID=coloque-o-client-id-aqui
GOOGLE_CLIENT_SECRET=coloque-o-client-secret-aqui
GOOGLE_ALLOWED_EMAILS=editor@example.com
GITHUB_APP_ID=coloque-o-id-da-app-aqui
GITHUB_APP_INSTALLATION_ID=coloque-o-id-da-instalacao-aqui
GITHUB_APP_PRIVATE_KEY=cole-a-chave-privada-pem-aqui
